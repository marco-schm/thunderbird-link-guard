{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.13.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "link-guard@sayanetworks.eu",
      "strict_min_version": "151.0"
    }
  },
  "permissions": ["messagesRead", "scripting", "storage"],
  "background": {
    "scripts": ["english.js", "locale.js", "policy.js", "import-list.js", "safe-regex.js", "warning-rules.js",
      "domain-scope.js", "background.js"]
  },
  "message_display_scripts": [{
    "js": ["english.js", "locale.js", "policy.js", "access.js", "safe-regex.js", "warning-rules.js",
      "panel-style.js", "display.js"],
    "css": ["display.css"],
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "__MSG_optionsAction__"
  },
  "message_display_action": {
    "default_title": "__MSG_toolbarInitial__",
    "default_label": "__MSG_extensionName__",
    "default_icon": "icons/shield.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
